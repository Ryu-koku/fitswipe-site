---
interface Props { type: 'swipe' | 'graph' | 'friends' }
const { type } = Astro.props;
---
<div class:list={['feature-art', `feature-art--${type}`]}>
  {type === 'swipe' && <>
    <div class="swipe-orbit" aria-hidden="true"><span class="orbit-star">✳</span><span class="orbit-arrow">↗</span></div>
    <div class="input-note"><span>重量と回数を入力</span><span aria-hidden="true">↓</span></div>
    <div class="illustration-card"><span class="illustration-kicker">SET LOG</span><span class="illustration-title">入力したら、</span><strong>スワイプ！<span aria-hidden="true">↗</span></strong><span class="illustration-pill">右・上でセット完了</span></div>
    <p class="art-caption">左・下はスキップ。アプリ画面ではなく操作説明図です。</p>
  </>}
  {type === 'graph' && <>
    <div class="graph-card"><div class="graph-heading"><span class="illustration-kicker">YOUR TRAINING</span><span class="graph-dot" aria-hidden="true"></span></div><strong>記録の変化をチェック。</strong>
      <svg class="record-graph" viewBox="0 0 320 160" role="img" aria-label="上下する架空の記録を使ったグラフの説明図">
        <path d="M15 25h290M15 70h290M15 115h290" stroke="var(--line-green)" stroke-dasharray="4 5"/>
        <path d="M20 119 66 85 112 100 158 43 204 72 250 54 298 31" fill="none" stroke="var(--green)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
        <g fill="var(--white)" stroke="var(--green)" stroke-width="3"><circle cx="20" cy="119" r="5"/><circle cx="66" cy="85" r="5"/><circle cx="112" cy="100" r="5"/><circle cx="158" cy="43" r="5"/><circle cx="204" cy="72" r="5"/><circle cx="250" cy="54" r="5"/><circle cx="298" cy="31" r="5"/></g>
        <text x="15" y="150" fill="var(--muted)" font-size="11">説明用のダミーデータ</text>
      </svg>
      <span class="graph-label">完了セットに記録した重量の合計</span>
    </div><span class="floating-sticker" aria-hidden="true">MY PACE!</span><p class="art-caption">アプリ画面ではなく、記録を振り返る説明図です。</p>
  </>}
  {type === 'friends' && <>
    <div class="friends-line" aria-hidden="true"><span class="friend-avatar">☺</span><span class="friend-avatar friend-avatar--middle">☺</span><span class="friend-avatar">☺</span></div>
    <div class="share-note"><span class="illustration-kicker">WITH FRIENDS</span><strong>今日の記録、シェア！</strong><span class="share-check"><span aria-hidden="true">✓</span> 選んだ記録だけ</span></div>
    <span class="share-spark" aria-hidden="true">✳</span><p class="art-caption">招待した仲間との共有を表す説明図です。</p>
  </>}
</div>
